# Gelana API Environment Configuration Template
# Copy this file to .env in apps/api/ (or root for local development)

# Server Port (Render automatically sets PORT)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# PostgreSQL Connection String
# Local: postgresql://postgres:postgres@localhost:5432/inventory_db
# Neon Hosted Demo: postgresql://[user]:[password]@[neon-endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inventory_db

# JWT Secret for Session Authentication
# In production, MUST be a strong secret (at least 32 characters, e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=super_secret_development_key

# Frontend URL & CORS Configuration
# Set to your deployed Vercel domain for production, e.g. https://your-portfolio-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (optional, defaults include localhost and FRONTEND_URL)
# ALLOWED_ORIGINS=https://your-portfolio-app.vercel.app,http://localhost:5173

# Cookie Security Settings (optional - automatically configured based on NODE_ENV)
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false

# Portfolio Demo Seeding Guard
# Required only when running demo seed script in production mode against Neon
ALLOW_DEMO_SEED=false