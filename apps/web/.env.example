# Gelana Frontend Environment Configuration Template
# Copy this file to .env.local in apps/web/

# API URL Base
# Leave empty or unset to use the same-origin proxy (/api/v1) via Vite locally or Vercel rewrites in production.
# Only specify if calling the Render backend directly cross-origin:
# VITE_API_URL=https://YOUR_RENDER_SERVICE_URL.onrender.com/api/v1
# VITE_API_URL=/api/v1

# Local Development Proxy Target (optional, defaults to http://localhost:3000)
# VITE_DEV_API_TARGET=http://localhost:3000
