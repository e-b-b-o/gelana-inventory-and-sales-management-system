# Gelana Root Environment Reference
# Note: In production, environment variables are configured in the Render and Vercel dashboards.
# For local development, copy apps/api/.env.example to apps/api/.env

# API Configuration (apps/api/.env)
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inventory_db
JWT_SECRET=super_secret_development_key
FRONTEND_URL=http://localhost:5173

# Web Configuration (apps/web/.env.local - optional, defaults to same-origin /api/v1)
# VITE_API_URL=/api/v1
